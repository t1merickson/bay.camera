---
import { REGIONS, cameras } from '../lib/cameras';

const activeRegions = REGIONS.filter((r) => cameras.some((c) => c.region === r.slug));
---
<!doctype html>
<html lang="en" data-live="off">
<head>
  <meta charset="utf-8" />
  <title>bay.camera — Bay Area fog, light &amp; weather cameras</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  <meta name="description" content="A full-screen interactive map of live webcams, fog, and microclimates across the San Francisco Bay Area — GOES satellite, marine-layer altitude, and 200+ cameras." />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/styles/main.css" />
</head>
<body class="app">
  <div id="map" class="map-stage"></div>

  <header class="hud hud-top">
    <div class="brand"><h1>bay.camera</h1></div>
    <div class="conditions" id="conditions"><span class="cond-loading">conditions…</span></div>
    <span class="cond" id="fog-chip" hidden></span>
    <div class="hud-actions">
      <div class="layer-group" role="group" aria-label="Map layers">
        <button class="btn btn-layer" id="fog-btn" aria-pressed="false" title="GOES-18 satellite + marine-layer altitude">Fog</button>
        <button class="btn btn-layer" id="temps-btn" aria-pressed="false" title="Live microclimate temperatures">Temps</button>
        <button class="btn btn-layer" id="peaks-btn" aria-pressed="false" title="183 ALERTCalifornia peak cameras">Peaks</button>
      </div>
      <button class="btn" id="browse-btn" aria-expanded="false">Cameras</button>
      <label class="live-toggle">
        <input type="checkbox" id="live-switch" class="live-input" />
        <span class="live-switch" aria-hidden="true"><span class="live-thumb"></span></span>
        <span class="live-label">Live</span>
      </label>
    </div>
  </header>

  <aside class="panel panel-list" id="panel-list" hidden aria-label="Camera list">
    <div class="panel-head">
      <strong>Cameras <span class="muted" id="list-count"></span></strong>
      <button class="icon-btn" id="list-close" aria-label="Close">✕</button>
    </div>
    <div class="legend" id="filter-chips">
      {activeRegions.map((r) => (
        <button class="chip" data-region-chip={r.slug} aria-pressed="false"><span class={`dot region-${r.slug}`}></span>{r.label}</button>
      ))}
      <button class="chip chip-all" data-region-chip="all" aria-pressed="true">All</button>
    </div>
    <div class="cam-list" id="cam-list">
      {activeRegions.map((r) => (
        <div class="cam-list-group" data-region-section={r.slug}>
          <div class="cam-list-region">{r.label}</div>
          {cameras.filter((c) => c.region === r.slug).map((c) => (
            <button class="cam-list-item" data-id={c.id}>
              <span class={`dot region-${c.region}`}></span><span class="cli-name">{c.name}</span>
            </button>
          ))}
        </div>
      ))}
    </div>
  </aside>

  <aside class="panel panel-cam" id="panel-cam" hidden aria-label="Camera preview">
    <div class="panel-head">
      <strong id="cam-title">Camera</strong>
      <button class="icon-btn" id="cam-close" aria-label="Close">✕</button>
    </div>
    <div class="cam-view" id="cam-view"></div>
    <div class="cam-info" id="cam-info"></div>
  </aside>

  <aside class="fog-card" id="fog-card" hidden aria-label="Marine layer estimate">
    <div class="fog-head">Marine layer</div>
    <div class="fog-main" id="fog-main">—</div>
    <div class="fog-sub" id="fog-sub"></div>
  </aside>

  <div id="peaks-legend" class="legend legend-map peaks-legend" hidden>
    <span class="legend-item"><span class="dot dot-peak-clear"></span>Clear</span>
    <span class="legend-item"><span class="dot dot-peak-fog"></span>In fog</span>
    <span class="legend-item"><span class="dot dot-peak-dark"></span>Dark</span>
    <span class="legend-item"><span class="dot dot-peak-unsampled"></span>Unsampled</span>
  </div>

  <div class="legend legend-map">
    {activeRegions.map((r) => (
      <span class="legend-item"><span class={`dot region-${r.slug}`}></span>{r.label}</span>
    ))}
  </div>

  <script>
    import '../scripts/main';
  </script>
</body>
</html>
